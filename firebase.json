{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "site": "cartpunch-5b2d8",
      "public": "frontend_admin",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/Login.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "site": "cartpunch-monitor-5b2d8",
      "public": "frontend_monitor",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/Monitor.html"
        }
      ]
    }
  ]
}
